# Application Environment
ENVIRONMENT=development
PROJECT_NAME="SEQA Developer Onboarding & Provisioning Platform"
API_V1_PREFIX=/api/v1

# Database Configuration
# Local SQLite fallback for zero-config startup:
DATABASE_URL=sqlite:///./provision.db
# PostgreSQL for production/docker:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/seqa_db

# Security & Authentication
JWT_SECRET=seqa_enterprise_jwt_secret_key_change_in_production_2026!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Third-Party Integrations
# Real GitHub PAT token (classic with repo & admin:org scopes, or fine-grained)
GITHUB_TOKEN=
GITHUB_ORG=seqa-enterprise

# Slack Webhook for notification events
SLACK_WEBHOOK_URL=

# CORS Configuration (JSON-encoded array of allowed origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Initial Admin Credentials (seeded on first boot if DB is empty)
FIRST_SUPERUSER_EMAIL=admin@seqa.dev
FIRST_SUPERUSER_PASSWORD=AdminPass123!
FIRST_SUPERUSER_NAME="System Administrator"
